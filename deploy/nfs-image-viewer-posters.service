[Unit]
Description=Generate NFS Image Viewer video posters
After=network-online.target nfs-image-viewer-index.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/nfs-image-viewer
Environment=NFS_VIEWER_MEDIA_ROOT=/mnt/yeeyang
EnvironmentFile=-%h/.config/nfs-image-viewer/env
ExecStart=%h/projects/nfs-image-viewer/.venv/bin/python posters.py
UMask=0077
Nice=12
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
