[Unit]
Description=Refresh NFS Image Viewer media catalogue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/nfs-image-viewer
Environment=NFS_VIEWER_MEDIA_ROOT=/mnt/yeeyang
EnvironmentFile=-%h/.config/nfs-image-viewer/env
ExecStart=%h/projects/nfs-image-viewer/.venv/bin/python scanner.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
