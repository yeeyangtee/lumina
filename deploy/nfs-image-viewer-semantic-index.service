[Unit]
Description=Generate NFS Image Viewer semantic embeddings
After=network-online.target nfs-image-viewer-index.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/nfs-image-viewer
Environment=NFS_VIEWER_MEDIA_ROOT=/mnt/yeeyang
EnvironmentFile=-%h/.config/nfs-image-viewer/env
ExecStart=%h/projects/nfs-image-viewer/.venv/bin/python semantic_index.py --batch-size 16
UMask=0077
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
