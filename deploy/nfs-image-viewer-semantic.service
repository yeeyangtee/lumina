[Unit]
Description=NFS Image Viewer semantic search service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/nfs-image-viewer
Environment=NFS_VIEWER_MEDIA_ROOT=/mnt/yeeyang
EnvironmentFile=-%h/.config/nfs-image-viewer/env
ExecStart=%h/projects/nfs-image-viewer/.venv/bin/python -m gunicorn --workers 1 --threads 2 --worker-class gthread --timeout 120 --bind 127.0.0.1:5051 semantic_wsgi:application
Restart=on-failure
RestartSec=8
UMask=0077
Nice=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
